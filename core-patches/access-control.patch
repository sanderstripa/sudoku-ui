@@ -0,0 +1,311 @@
+package access
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const APIVersion = 1
+
+type Policy struct {
+	Users map[string]string `json:"users"`
+}
+
+type SessionView struct {
+	ID        string    `json:"id"`
+	SourceIP  string    `json:"source_ip"`
+	StartedAt time.Time `json:"started_at"`
+	RX        uint64    `json:"rx"`
+	TX        uint64    `json:"tx"`
+}
+
+type UserView struct {
+	UserHash string        `json:"user_hash"`
+	Status   string        `json:"status"`
+	LastSeen time.Time     `json:"last_seen,omitempty"`
+	RX       uint64        `json:"rx"`
+	TX       uint64        `json:"tx"`
+	Sessions []SessionView `json:"sessions"`
+}
+
+type persistedUser struct {
+	LastSeen time.Time `json:"last_seen,omitempty"`
+	RX       uint64    `json:"rx"`
+	TX       uint64    `json:"tx"`
+}
+
+type Manager struct {
+	mu         sync.Mutex
+	policy     Policy
+	users      map[string]*persistedUser
+	sessions   map[string]map[string]*trackedConn
+	statsPath  string
+	policyPath string
+	sequence   uint64
+}
+
+func NewManager(statsPath string, policyPaths ...string) *Manager {
+	policyPath := ""
+	if len(policyPaths) > 0 {
+		policyPath = policyPaths[0]
+	}
+	m := &Manager{policy: Policy{Users: map[string]string{}}, users: map[string]*persistedUser{}, sessions: map[string]map[string]*trackedConn{}, statsPath: statsPath, policyPath: policyPath}
+	if b, err := os.ReadFile(statsPath); err == nil {
+		_ = json.Unmarshal(b, &m.users)
+	}
+	if b, err := os.ReadFile(policyPath); err == nil {
+		_ = json.Unmarshal(b, &m.policy)
+		if m.policy.Users == nil {
+			m.policy.Users = map[string]string{}
+		}
+	}
+	return m
+}
+
+func (m *Manager) Allowed(userHash string) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.policy.Users[strings.ToLower(userHash)] != "disabled" && m.policy.Users[strings.ToLower(userHash)] != "revoked"
+}
+
+func (m *Manager) SetPolicy(p Policy) error {
+	clean := Policy{Users: map[string]string{}}
+	for hash, status := range p.Users {
+		hash, status = strings.ToLower(strings.TrimSpace(hash)), strings.ToLower(strings.TrimSpace(status))
+		if hash == "" || (status != "enabled" && status != "disabled" && status != "revoked") {
+			return fmt.Errorf("invalid policy entry %q", hash)
+		}
+		clean.Users[hash] = status
+	}
+	m.mu.Lock()
+	for hash, status := range m.policy.Users {
+		if status == "revoked" {
+			clean.Users[hash] = "revoked"
+		}
+	}
+	m.policy = clean
+	if err := m.persistPolicyLocked(); err != nil {
+		m.mu.Unlock()
+		return err
+	}
+	var closeList []*trackedConn
+	for hash, sessions := range m.sessions {
+		if clean.Users[hash] == "disabled" || clean.Users[hash] == "revoked" {
+			for _, s := range sessions {
+				closeList = append(closeList, s)
+			}
+		}
+	}
+	m.mu.Unlock()
+	for _, s := range closeList {
+		_ = s.Close()
+	}
+	return nil
+}
+
+func (m *Manager) persistPolicyLocked() error {
+	if m.policyPath == "" {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(m.policyPath), 0700); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(m.policy, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := m.policyPath + ".tmp"
+	if err = os.WriteFile(tmp, b, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, m.policyPath)
+}
+
+func (m *Manager) Track(userHash, sourceIP string, conn net.Conn) (net.Conn, error) {
+	userHash = strings.ToLower(strings.TrimSpace(userHash))
+	if userHash == "" {
+		return nil, errors.New("missing user hash")
+	}
+	if !m.Allowed(userHash) {
+		return nil, errors.New("access key disabled or revoked")
+	}
+	id := fmt.Sprintf("%x", atomic.AddUint64(&m.sequence, 1))
+	t := &trackedConn{Conn: conn, manager: m, userHash: userHash, id: id, sourceIP: sourceIP, startedAt: time.Now()}
+	m.mu.Lock()
+	if m.policy.Users[userHash] == "disabled" || m.policy.Users[userHash] == "revoked" {
+		m.mu.Unlock()
+		return nil, errors.New("access key disabled or revoked")
+	}
+	if m.sessions[userHash] == nil {
+		m.sessions[userHash] = map[string]*trackedConn{}
+	}
+	m.sessions[userHash][id] = t
+	if m.users[userHash] == nil {
+		m.users[userHash] = &persistedUser{}
+	}
+	m.users[userHash].LastSeen = t.startedAt
+	m.mu.Unlock()
+	return t, nil
+}
+
+func (m *Manager) finish(t *trackedConn) {
+	m.mu.Lock()
+	u := m.users[t.userHash]
+	if u == nil {
+		u = &persistedUser{}
+		m.users[t.userHash] = u
+	}
+	u.RX += atomic.LoadUint64(&t.rx)
+	u.TX += atomic.LoadUint64(&t.tx)
+	u.LastSeen = time.Now()
+	delete(m.sessions[t.userHash], t.id)
+	if len(m.sessions[t.userHash]) == 0 {
+		delete(m.sessions, t.userHash)
+	}
+	_ = m.persistLocked()
+	m.mu.Unlock()
+}
+
+func (m *Manager) Snapshot() []UserView {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	hashes := map[string]bool{}
+	for h := range m.users {
+		hashes[h] = true
+	}
+	for h := range m.policy.Users {
+		hashes[h] = true
+	}
+	for h := range m.sessions {
+		hashes[h] = true
+	}
+	keys := make([]string, 0, len(hashes))
+	for h := range hashes {
+		keys = append(keys, h)
+	}
+	sort.Strings(keys)
+	out := make([]UserView, 0, len(keys))
+	for _, h := range keys {
+		v := UserView{UserHash: h, Status: m.policy.Users[h]}
+		if v.Status == "" {
+			v.Status = "enabled"
+		}
+		if u := m.users[h]; u != nil {
+			v.LastSeen, v.RX, v.TX = u.LastSeen, u.RX, u.TX
+		}
+		for _, s := range m.sessions[h] {
+			rx, tx := atomic.LoadUint64(&s.rx), atomic.LoadUint64(&s.tx)
+			v.RX += rx
+			v.TX += tx
+			v.Sessions = append(v.Sessions, SessionView{ID: s.id, SourceIP: s.sourceIP, StartedAt: s.startedAt, RX: rx, TX: tx})
+		}
+		sort.Slice(v.Sessions, func(i, j int) bool { return v.Sessions[i].StartedAt.Before(v.Sessions[j].StartedAt) })
+		out = append(out, v)
+	}
+	return out
+}
+
+func (m *Manager) persistLocked() error {
+	if m.statsPath == "" {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(m.statsPath), 0700); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(m.users, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := m.statsPath + ".tmp"
+	if err = os.WriteFile(tmp, b, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, m.statsPath)
+}
+
+func (m *Manager) ServeUnix(path string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		return err
+	}
+	_ = os.Remove(path)
+	l, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		_ = l.Close()
+		return err
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/state", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"api_version": APIVersion, "users": m.Snapshot()})
+	})
+	mux.HandleFunc("/v1/policy", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		var p Policy
+		if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<20)).Decode(&p); err != nil {
+			http.Error(w, "invalid policy", 400)
+			return
+		}
+		if err := m.SetPolicy(p); err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "api_version": APIVersion})
+	})
+	return (&http.Server{Handler: mux, ReadHeaderTimeout: 5 * time.Second}).Serve(l)
+}
+
+type trackedConn struct {
+	net.Conn
+	manager                *Manager
+	userHash, id, sourceIP string
+	startedAt              time.Time
+	rx, tx                 uint64
+	once                   sync.Once
+}
+
+func (c *trackedConn) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	atomic.AddUint64(&c.rx, uint64(n))
+	return n, e
+}
+func (c *trackedConn) Write(p []byte) (int, error) {
+	n, e := c.Conn.Write(p)
+	atomic.AddUint64(&c.tx, uint64(n))
+	return n, e
+}
+func (c *trackedConn) Close() error {
+	e := c.Conn.Close()
+	c.once.Do(func() { c.manager.finish(c) })
+	return e
+}
+func (c *trackedConn) CloseRead() error {
+	if x, ok := c.Conn.(interface{ CloseRead() error }); ok {
+		return x.CloseRead()
+	}
+	return nil
+}
+func (c *trackedConn) CloseWrite() error {
+	if x, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return x.CloseWrite()
+	}
+	return c.Close()
+}
