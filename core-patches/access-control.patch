+package access
+
+import (
+	"io"
+	"net"
+	"path/filepath"
+	"testing"
+)
+
+func TestDisableClosesSessionsAndRejectsNew(t *testing.T) {
+	m := NewManager(filepath.Join(t.TempDir(), "stats.json"))
+	a, b := net.Pipe()
+	defer b.Close()
+	c, err := m.Track("abc", "203.0.113.7", a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	go io.Copy(io.Discard, b)
+	if _, err = c.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+	before := m.Snapshot()[0]
+	if len(before.Sessions) != 1 || before.Sessions[0].SourceIP != "203.0.113.7" || before.TX != 5 {
+		t.Fatalf("bad accounting: %#v", before)
+	}
+	if err = m.SetPolicy(Policy{Users: map[string]string{"abc": "disabled"}}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.Track("abc", "203.0.113.8", a); err == nil {
+		t.Fatal("disabled key accepted")
+	}
+	if len(m.Snapshot()[0].Sessions) != 0 {
+		t.Fatal("active session was not closed")
+	}
+	if m.Snapshot()[0].TX != 5 {
+		t.Fatal("traffic total was not retained")
+	}
+}
+
+func TestRevokedCannotBeEnabledByStalePolicy(t *testing.T) {
+	m := NewManager("")
+	if err := m.SetPolicy(Policy{Users: map[string]string{"abc": "revoked"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.SetPolicy(Policy{Users: map[string]string{"abc": "enabled"}}); err != nil {
+		t.Fatal(err)
+	}
+	if m.Allowed("abc") {
+		t.Fatal("revoked key allowed")
+	}
+}

