+
+// logUserInfo logs an info message, prepending [User:label] when label is non-empty.
+func logUserInfo(tag, label, format string, args ...interface{}) {
+	if label != "" {
+		format = "[User:" + label + "] " + format
+	}
+	logx.Infof(tag, format, args...)
+}
+
+// logUserWarn logs a warning message, prepending [User:label] when label is non-empty.
+func logUserWarn(tag, label, format string, args ...interface{}) {
+	if label != "" {
+		format = "[User:" + label + "] " + format
+	}
+	logx.Warnf(tag, format, args...)
+}
+
+func RunServer(cfg *config.Config, tables []*sudoku.Table) {
+	logx.InstallStd()
+	accessManager := access.NewManager(sudokuUIEnvOr("SUDOKU_STATS_PATH", "/var/lib/sudoku-ui/core-stats.json"), sudokuUIEnvOr("SUDOKU_POLICY_PATH", "/etc/sudoku-ui/core-policy.json"))
+	go func() {
+		if err := accessManager.ServeUnix(sudokuUIEnvOr("SUDOKU_CONTROL_SOCKET", "/run/sudoku/core.sock")); err != nil {
+			logx.Warnf("Access", "local API stopped: %v", err)
+		}
+	}()
+
+	userReg, err := users.NewRegistry(cfg.Users)
+	if err != nil {
+		logx.Fatalf("Server", "%v", err)
+	}
+	if userReg != nil {
+		logx.Infof("Server", "User whitelist enabled (%d users)", len(cfg.Users))
+		stopUsage, err := userReg.TrackUsage(cfg.UsageFile)
+		if err != nil {
+			logx.Fatalf("Server", "load user usage: %v (fix or delete the file to reset usage)", err)
+		}
+		defer stopUsage()
+	}
+	if cfg.ExternalController != "" {
+		stopAPI, err := controller.Start(controller.Options{
+			Addr: cfg.ExternalController, Secret: cfg.Secret, Users: userReg.Stats,
+		})
+		if err != nil {
+			logx.Fatalf("API", "External controller: %v", err)
+		}
+		defer stopAPI()
+	}
+
+	// Listen on TCP port.
+	l, err := net.Listen("tcp", fmt.Sprintf(":%d", cfg.LocalPort))
+	if err != nil {
+		logx.Fatalf("Server", "%v", err)
+	}
+	logx.Infof("Server", "Server on :%d (Fallback: %s)", cfg.LocalPort, cfg.FallbackAddr)
+
+	var revMgr *reverse.Manager
+	if cfg.Reverse != nil && strings.TrimSpace(cfg.Reverse.Listen) != "" {
+		revMgr = reverse.NewManager()
+		revListen := strings.TrimSpace(cfg.Reverse.Listen)
+		go func() {
+			logx.Infof("Reverse", "entry on %s", revListen)
+			if err := reverse.ServeEntry(revListen, revMgr); err != nil {
+				logx.Warnf("Reverse", "entry error: %v", err)
+			}
+		}()
+	}
+
+	var tunnelSrv *httpmask.TunnelServer
+	if cfg.HTTPMaskTunnelEnabled() {
+		tunnelSrv = httpmask.NewTunnelServer(httpmask.TunnelServerOptions{
+			Mode:     cfg.HTTPMask.Mode,
+			PathRoot: cfg.HTTPMask.PathRoot,
+			AuthKey:  cfg.Key,
+			EarlyHandshake: tunnel.NewHTTPMaskServerEarlyHandshake(tunnel.EarlyCodecConfig{
+				PSK:                cfg.Key,
+				AEAD:               cfg.AEAD,
+				EnablePureDownlink: cfg.EnablePureDownlink,
+				PaddingMin:         cfg.PaddingMin,
+				PaddingMax:         cfg.PaddingMax,
+				WireWrap: func(userHash string, raw net.Conn) net.Conn {
+					if u := userReg.Lookup(userHash); u != nil && !u.Blocked {
+						return u.WrapWire(raw)
+					}
+					return raw
+				},
+			}, tables, tunnel.AllowHandshakeReplay),
+			PassThroughOnReject: cfg.SuspiciousAction == "silent" ||
+				cfg.SuspiciousAction == "fallback" && strings.TrimSpace(cfg.FallbackAddr) != "",
+		})
+	}
+
+	serveUntilShutdown("Server", l, func(c net.Conn) {
+		handleServerConn(c, cfg, tables, tunnelSrv, revMgr, userReg, accessManager)
+	})
+}
+
+// rejectReason explains why a handshaked user may not open a session, or returns "" when it may.
+func rejectReason(user *users.User) string {
+	switch {
+	case user == nil:
+		return "not in users whitelist"
+	case user.Blocked:
+		return "blocked"
+	case user.Exceeded():
+		return "data quota exceeded"
+	}
+	return ""
+}
+
+func handleServerConn(rawConn net.Conn, cfg *config.Config, tables []*sudoku.Table, tunnelSrv *httpmask.TunnelServer, revMgr *reverse.Manager, userReg *users.Registry, accessManagers ...*access.Manager) {
+	if tunnelSrv != nil {
+		res, c, err := tunnelSrv.HandleConn(rawConn)
+		if err != nil {
+			logx.Warnf("Server/HTTP", "tunnel prelude failed: %v", err)
+			rawConn.Close()
+			return
+		}
+		switch res {
+		case httpmask.HandleDone:
+			return
+		case httpmask.HandleStartTunnel:
+			inner := *cfg
+			inner.HTTPMask.Disable = true
+			handleSudokuServerConn(c, rawConn, &inner, tables, false, revMgr, userReg, accessManagers...)
+			return
+		case httpmask.HandlePassThrough:
+			if r, ok := c.(interface{ IsHTTPMaskRejected() bool }); ok && r.IsHTTPMaskRejected() {
+				// Replay the rejected HTTPMask prefix once, then continue streaming from the raw TCP conn.
+				// Passing the replay wrapper as both arguments would duplicate the prefix on fallback.
+				handleSuspicious(c, rawConn, cfg)
+				return
+			}
+			handleSudokuServerConn(c, rawConn, cfg, tables, true, revMgr, userReg, accessManagers...)
+			return
+		default:
+			rawConn.Close()
+			return
+		}
+	}
+
+	handleSudokuServerConn(rawConn, rawConn, cfg, tables, true, revMgr, userReg, accessManagers...)
+}
+
+func handleSudokuServerConn(handshakeConn net.Conn, rawConn net.Conn, cfg *config.Config, tables []*sudoku.Table, allowFallback bool, revMgr *reverse.Manager, userReg *users.Registry, accessManagers ...*access.Manager) {
+	// Early-handshake conns are already wire-wrapped inside WrapConn; everything else is counted here.
+	var wire *users.WireConn
+	if userReg != nil {
+		if _, early := httpmask.EarlyHandshakeUserHash(handshakeConn); !early {
+			wire = users.NewWireConn(handshakeConn)
+			handshakeConn = wire
+		}
+	}
+
+	// Use Tunnel Abstraction for Handshake and Upgrade
+	tunnelConn, meta, err := tunnel.ServerHandshake(handshakeConn, cfg, tables)
+	if err != nil {
+		if suspErr, ok := err.(*tunnel.SuspiciousError); ok {
+			logx.Warnf("Security", "Suspicious connection: %v", suspErr.Err)
+			// Only meaningful for direct TCP/legacy mask connections.
+			if allowFallback {
+				// Use handshakeConn for proxying so we preserve any pre-read/replayed bytes (e.g. HTTP tunnel pass-through prefixes),
+				// but still use suspErr.Conn to extract any consumed/recorded bytes for the fallback.
+				handleSuspicious(suspErr.Conn, handshakeConn, cfg)
+			} else {
+				rawConn.Close()
+			}
+		} else {
+			logx.Warnf("Server", "Handshake failed: %v", err)
+			rawConn.Close()
+		}
+		return
+	}
+
+	userHash := ""
+	if meta != nil {
+		userHash = meta.UserHash
+	}
+	label := userHash
+	if userReg != nil {
+		user := userReg.Lookup(userHash)
+		if reason := rejectReason(user); reason != "" {
+			// Aliases fall back to the hash, so a private key never reaches the log.
+			who := userHash
+			if user != nil {
+				who = user.Alias
+			}
+			logx.Warnf("Server", "[User:%s] rejected: %s", who, reason)
+			_ = tunnelConn.Close()
+			return
+		}
+		label = user.Alias
+		if wire != nil {
+			wire.Bind(user)
+		}
+		tunnelConn = user.WrapPayload(tunnelConn)
+	}
+
+	if len(accessManagers) > 0 && accessManagers[0] != nil {
+		sourceIP := rawConn.RemoteAddr().String()
+		if host, _, err := net.SplitHostPort(sourceIP); err == nil {
+			sourceIP = host
+		}
+		tracked, err := accessManagers[0].Track(userHash, sourceIP, tunnelConn)
+		if err != nil {
+			logUserWarn("Access", userHash, "connection rejected: %v", err)
+			_ = tunnelConn.Close()
+			return
+		}
+		tunnelConn = tracked
+		defer tunnelConn.Close()
+	}
+
+	// Read the first KIP control message to detect session type (UoT / Mux / Reverse / normal).
+	var msg *tunnel.KIPMessage
+	for {
+		m, err := tunnel.ReadKIPMessage(tunnelConn)
+		if err != nil {
+			logx.Warnf("Server", "Failed to read KIP message: %v", err)
+			return
+		}
+		if m.Type == tunnel.KIPTypeKeepAlive {
+			continue
+		}
+		msg = m
+		break
+	}
+
+	switch msg.Type {
+	case tunnel.KIPTypeStartUoT:
+		logUserInfo("Server/UoT", label, "session start")
+		if err := tunnel.HandleUoTServer(tunnelConn); err != nil {
+			logUserWarn("Server/UoT", label, "session end: %v", err)
+		} else {
+			logUserInfo("Server/UoT", label, "session end")
+		}
+		return
+	case tunnel.KIPTypeStartMux:
+		logUserInfo("Server/Mux", label, "session start")
+		logConnect := func(addr string) {
+			logUserInfo("Server/Mux", label, "Connecting to %s", addr)
+		}
+		if err := tunnel.HandleMuxServer(tunnelConn, logConnect); err != nil {
+			logUserWarn("Server/Mux", label, "session end: %v", err)
+		} else {
+			logUserInfo("Server/Mux", label, "session end")
+		}
+		return
+	case tunnel.KIPTypeStartRev:
+		if revMgr == nil {
+			logx.Warnf("Server/Reverse", "reverse proxy not enabled (missing reverse.listen)")
+			return
+		}
+		logUserInfo("Server/Reverse", label, "session start")
+		if err := reverse.HandleServerSession(tunnelConn, revMgr, msg.Payload); err != nil {
+			logUserWarn("Server/Reverse", label, "session end: %v", err)
+		} else {
+			logUserInfo("Server/Reverse", label, "session end")
+		}
+		return
+	case tunnel.KIPTypeOpenTCP:
+		destAddrStr, err := protocol.DecodeAddress(msg.Payload)
+		if err != nil {
+			logx.Warnf("Server", "Failed to decode target address: %v", err)
+			return
+		}
+
+		logUserInfo("Server", label, "Connecting to %s", destAddrStr)
+
+		target, err := net.DialTimeout("tcp", destAddrStr, 10*time.Second)
+		if err != nil {
+			logx.Warnf("Server", "Connect target failed: %v", err)
+			return
+		}
+
+		connutil.PipeConn(tunnelConn, target)
+		return
+	default:
+		logx.Warnf("Server", "Unknown KIP message: %d", msg.Type)
+		return
+	}
+}
+
+func sudokuUIEnvOr(name, fallback string) string {
+	if value := strings.TrimSpace(os.Getenv(name)); value != "" {
+		return value
+	}
+	return fallback
+}
diff --git a/internal/access/manager.go b/internal/access/manager.go
new file mode 100644
index 0000000..5acc349
--- /dev/null
+++ b/internal/access/manager.go
@@ -0,0 +1,311 @@
+package access
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const APIVersion = 1
+
+type Policy struct {
+	Users map[string]string `json:"users"`
+}
+
+type SessionView struct {
+	ID        string    `json:"id"`
+	SourceIP  string    `json:"source_ip"`
+	StartedAt time.Time `json:"started_at"`
+	RX        uint64    `json:"rx"`
+	TX        uint64    `json:"tx"`
+}
+
+type UserView struct {
+	UserHash string        `json:"user_hash"`
+	Status   string        `json:"status"`
+	LastSeen time.Time     `json:"last_seen,omitempty"`
+	RX       uint64        `json:"rx"`
+	TX       uint64        `json:"tx"`
+	Sessions []SessionView `json:"sessions"`
+}
+
+type persistedUser struct {
+	LastSeen time.Time `json:"last_seen,omitempty"`
+	RX       uint64    `json:"rx"`
+	TX       uint64    `json:"tx"`
+}
+
+type Manager struct {
+	mu         sync.Mutex
+	policy     Policy
+	users      map[string]*persistedUser
+	sessions   map[string]map[string]*trackedConn
+	statsPath  string
+	policyPath string
+	sequence   uint64
+}
+
+func NewManager(statsPath string, policyPaths ...string) *Manager {
+	policyPath := ""
+	if len(policyPaths) > 0 {
+		policyPath = policyPaths[0]
+	}
+	m := &Manager{policy: Policy{Users: map[string]string{}}, users: map[string]*persistedUser{}, sessions: map[string]map[string]*trackedConn{}, statsPath: statsPath, policyPath: policyPath}
+	if b, err := os.ReadFile(statsPath); err == nil {
+		_ = json.Unmarshal(b, &m.users)
+	}
+	if b, err := os.ReadFile(policyPath); err == nil {
+		_ = json.Unmarshal(b, &m.policy)
+		if m.policy.Users == nil {
+			m.policy.Users = map[string]string{}
+		}
+	}
+	return m
+}
+
+func (m *Manager) Allowed(userHash string) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.policy.Users[strings.ToLower(userHash)] != "disabled" && m.policy.Users[strings.ToLower(userHash)] != "revoked"
+}
+
+func (m *Manager) SetPolicy(p Policy) error {
+	clean := Policy{Users: map[string]string{}}
+	for hash, status := range p.Users {
+		hash, status = strings.ToLower(strings.TrimSpace(hash)), strings.ToLower(strings.TrimSpace(status))
+		if hash == "" || (status != "enabled" && status != "disabled" && status != "revoked") {
+			return fmt.Errorf("invalid policy entry %q", hash)
+		}
+		clean.Users[hash] = status
+	}
+	m.mu.Lock()
+	for hash, status := range m.policy.Users {
+		if status == "revoked" {
+			clean.Users[hash] = "revoked"
+		}
+	}
+	m.policy = clean
+	if err := m.persistPolicyLocked(); err != nil {
+		m.mu.Unlock()
+		return err
+	}
+	var closeList []*trackedConn
+	for hash, sessions := range m.sessions {
+		if clean.Users[hash] == "disabled" || clean.Users[hash] == "revoked" {
+			for _, s := range sessions {
+				closeList = append(closeList, s)
+			}
+		}
+	}
+	m.mu.Unlock()
+	for _, s := range closeList {
+		_ = s.Close()
+	}
+	return nil
+}
+
+func (m *Manager) persistPolicyLocked() error {
+	if m.policyPath == "" {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(m.policyPath), 0700); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(m.policy, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := m.policyPath + ".tmp"
+	if err = os.WriteFile(tmp, b, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, m.policyPath)
+}
+
+func (m *Manager) Track(userHash, sourceIP string, conn net.Conn) (net.Conn, error) {
+	userHash = strings.ToLower(strings.TrimSpace(userHash))
+	if userHash == "" {
+		return nil, errors.New("missing user hash")
+	}
+	if !m.Allowed(userHash) {
+		return nil, errors.New("access key disabled or revoked")
+	}
+	id := fmt.Sprintf("%x", atomic.AddUint64(&m.sequence, 1))
+	t := &trackedConn{Conn: conn, manager: m, userHash: userHash, id: id, sourceIP: sourceIP, startedAt: time.Now()}
+	m.mu.Lock()
+	if m.policy.Users[userHash] == "disabled" || m.policy.Users[userHash] == "revoked" {
+		m.mu.Unlock()
+		return nil, errors.New("access key disabled or revoked")
+	}
+	if m.sessions[userHash] == nil {
+		m.sessions[userHash] = map[string]*trackedConn{}
+	}
+	m.sessions[userHash][id] = t
+	if m.users[userHash] == nil {
+		m.users[userHash] = &persistedUser{}
+	}
+	m.users[userHash].LastSeen = t.startedAt
+	m.mu.Unlock()
+	return t, nil
+}
+
+func (m *Manager) finish(t *trackedConn) {
+	m.mu.Lock()
+	u := m.users[t.userHash]
+	if u == nil {
+		u = &persistedUser{}
+		m.users[t.userHash] = u
+	}
+	u.RX += atomic.LoadUint64(&t.rx)
+	u.TX += atomic.LoadUint64(&t.tx)
+	u.LastSeen = time.Now()
+	delete(m.sessions[t.userHash], t.id)
+	if len(m.sessions[t.userHash]) == 0 {
+		delete(m.sessions, t.userHash)
+	}
+	_ = m.persistLocked()
+	m.mu.Unlock()
+}
+
+func (m *Manager) Snapshot() []UserView {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	hashes := map[string]bool{}
+	for h := range m.users {
+		hashes[h] = true
+	}
+	for h := range m.policy.Users {
+		hashes[h] = true
+	}
+	for h := range m.sessions {
+		hashes[h] = true
+	}
+	keys := make([]string, 0, len(hashes))
+	for h := range hashes {
+		keys = append(keys, h)
+	}
+	sort.Strings(keys)
+	out := make([]UserView, 0, len(keys))
+	for _, h := range keys {
+		v := UserView{UserHash: h, Status: m.policy.Users[h]}
+		if v.Status == "" {
+			v.Status = "enabled"
+		}
+		if u := m.users[h]; u != nil {
+			v.LastSeen, v.RX, v.TX = u.LastSeen, u.RX, u.TX
+		}
+		for _, s := range m.sessions[h] {
+			rx, tx := atomic.LoadUint64(&s.rx), atomic.LoadUint64(&s.tx)
+			v.RX += rx
+			v.TX += tx
+			v.Sessions = append(v.Sessions, SessionView{ID: s.id, SourceIP: s.sourceIP, StartedAt: s.startedAt, RX: rx, TX: tx})
+		}
+		sort.Slice(v.Sessions, func(i, j int) bool { return v.Sessions[i].StartedAt.Before(v.Sessions[j].StartedAt) })
+		out = append(out, v)
+	}
+	return out
+}
+
+func (m *Manager) persistLocked() error {
+	if m.statsPath == "" {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(m.statsPath), 0700); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(m.users, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := m.statsPath + ".tmp"
+	if err = os.WriteFile(tmp, b, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, m.statsPath)
+}
+
+func (m *Manager) ServeUnix(path string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		return err
+	}
+	_ = os.Remove(path)
+	l, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		_ = l.Close()
+		return err
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/state", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"api_version": APIVersion, "users": m.Snapshot()})
+	})
+	mux.HandleFunc("/v1/policy", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		var p Policy
+		if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<20)).Decode(&p); err != nil {
+			http.Error(w, "invalid policy", 400)
+			return
+		}
+		if err := m.SetPolicy(p); err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"ok": true, "api_version": APIVersion})
+	})
+	return (&http.Server{Handler: mux, ReadHeaderTimeout: 5 * time.Second}).Serve(l)
+}
+
+type trackedConn struct {
+	net.Conn
+	manager                *Manager
+	userHash, id, sourceIP string
+	startedAt              time.Time
+	rx, tx                 uint64
+	once                   sync.Once
+}
+
+func (c *trackedConn) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	atomic.AddUint64(&c.rx, uint64(n))
+	return n, e
+}
+func (c *trackedConn) Write(p []byte) (int, error) {
+	n, e := c.Conn.Write(p)
+	atomic.AddUint64(&c.tx, uint64(n))
+	return n, e
+}
+func (c *trackedConn) Close() error {
+	e := c.Conn.Close()
+	c.once.Do(func() { c.manager.finish(c) })
+	return e
+}
+func (c *trackedConn) CloseRead() error {
+	if x, ok := c.Conn.(interface{ CloseRead() error }); ok {
+		return x.CloseRead()
+	}
+	return nil
+}
+func (c *trackedConn) CloseWrite() error {
+	if x, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return x.CloseWrite()
+	}
+	return c.Close()
+}
